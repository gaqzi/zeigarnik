#!/usr/bin/env bash
# Usage: script/test [unit|wiring|eval|all]
#
# With no layer, runs the free tests: typecheck, lint, the README's decision
# overview held to src/core/readme-decision-overview.ts, the domain core
# and the mod wiring. Formats the code first, or on CI (CI set) checks the
# formatting instead. `eval` costs tokens and takes minutes; `all` runs every
# layer, cheapest first, and stops at the first that fails (zg-564).

set -euo pipefail
cd "$(dirname "$0")/.."

usage() {
  echo "usage: script/test [unit|wiring|eval|all]" >&2
  exit 2
}

layer=${1:-free}
[ $# -le 1 ] || usage

step() {
  printf '\n━━ %s\n\n' "$1"
}

# claude plugin test runs every test under a plugin folder, and follows no
# symbolic links, so one layer runs from a copy holding only its tests.
tree=$(mktemp -d "${TMPDIR:-/tmp}/zg-test.XXXXXX")
trap 'rm -rf "$tree"' EXIT

new_tree() {
  rm -rf "${tree:?}"/* "$tree"/.claude-plugin
  mkdir -p "$tree/.claude-plugin"
  cp .claude-plugin/plugin.json "$tree/.claude-plugin/"
  cp -R types "$tree/types"
}

unit() {
  step "Domain core"
  new_tree
  mkdir -p "$tree/hooks" "$tree/src"
  echo '{ "modules": ["./register.ts"] }' >"$tree/hooks/hooks.json"
  echo 'export const register = () => {}' >"$tree/hooks/register.ts"
  cp -R src/core "$tree/src/core"
  claude plugin test "$tree"
}

wiring() {
  step "Mod wiring"
  new_tree
  cp -R hooks src commands "$tree/"
  find "$tree/src/core" -name '*.test.ts*' -delete
  claude plugin test "$tree"
}

static() {
  if [ -n "${CI:-}" ]; then
    step "Formatting"
    node_modules/.bin/biome format .
  else
    step "Format"
    script/fmt
  fi
  step "Typecheck"
  vendored=$(head -n 1 vendor/claude-code/index.d.ts | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+')
  installed=$(claude --version | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -n 1)
  if [ "$vendored" != "$installed" ]; then
    echo "warning: vendor/ has Claude Code $vendored's mod API, $installed is installed: run script/update-vendor-deps"
  fi
  node_modules/.bin/tsc -p .
  echo "ok"
  step "Lint"
  node_modules/.bin/biome lint .
  step "README"
  readme_overview
}

# The README shows what show renders for a decision, and the unit tests pin
# src/core/readme-decision-overview.ts to the render: the README holds to it.
readme_overview() {
  local module=src/core/readme-decision-overview.ts
  local in_readme in_module
  in_readme=$(awk '
    found && /^```/ { fence++; if (fence == 2) exit; next }
    found && fence == 1 { print }
    /^The overview of a decision reads like this:$/ { found = 1 }
  ' README.md)
  in_module=$(node --input-type=module -e \
    "import { readmeDecisionOverview as l } from './$module'; console.log(l.join('\n'))")
  printf '%s\n' "$in_readme" >"$tree/readme"
  printf '%s\n' "$in_module" >"$tree/module"
  if ! diff "$tree/readme" "$tree/module"; then
    echo "README.md's decision overview (under \"The overview of a decision reads like this:\") differs from $module: lines marked < are in the README, > in the module" >&2
    return 1
  fi
  echo "ok"
}

eval_layer() {
  step "Evals (costs tokens)"
  # Each run of a case resuming history.jsonl leaves its session beside it.
  rm -f evals/*/????????-????-????-????-????????????.jsonl
  # A case lists the tools it needs; zg's own still need granting here.
  # --scaffold: cases seed a recorded session's log; they are ours, so trusted.
  # A haiku judge failed correct handoff proposals; sonnet didn't, in 10 runs.
  claude plugin eval . --trust-plugin --scaffold --judge-model sonnet --no-publish \
    --allow-tools 'mcp__zg__*'
}

case "$layer" in
  free) static; unit; wiring ;;
  unit) unit ;;
  wiring) wiring ;;
  eval) eval_layer ;;
  all) static; unit; wiring; eval_layer ;;
  *) usage ;;
esac
