#!/usr/bin/env bash
# Usage: script/decisions
#
# Renders every decision bead into docs/decisions.md (zg-pvk). Run it after
# creating or changing a decision, and commit the file with the change.

set -euo pipefail
cd "$(dirname "$0")/.."
. script/lib/areas.sh

out=docs/decisions.md
mkdir -p docs

decisions=$(bd query "type=decision" --all --limit 0 --json)

# A decision without a valid area label never reaches script/context's index
# (zg-nti), so refuse to render until it has one.
problems=
while IFS=$'\t' read -r id labels; do
  valid=
  for a in $labels; do
    case "$a" in
      area:*)
        if is_area "${a#area:}"; then
          valid=1
        else
          problems="$problems$id: unknown area label $a"$'\n'
        fi
        ;;
    esac
  done
  [ -n "$valid" ] || problems="$problems$id: no valid area label"$'\n'
done < <(jq -r '.[] | [.id, (.labels // [] | join(" "))] | @tsv' <<<"$decisions")
if [ -n "$problems" ]; then
  printf '%s' "$problems" >&2
  echo "fix the labels (areas: $AREAS), then rerun script/decisions" >&2
  exit 1
fi

jq -r '
  def areas: [.labels // [] | .[] | select(startswith("area:")) | ltrimstr("area:")] | join(", ");
  def state:
    if .status != "closed" then "To decide"
    elif .close_reason == "accepted" then "Accepted"
    else "Superseded or withdrawn" end;
  def entry:
    "### \(.id): \(.title)\n\n"
    + "Areas: \(areas)"
    + (if state == "Superseded or withdrawn" then "  \nClosed: \(.close_reason)" else "" end)
    + "\n\n"
    + ("\n" + (.description // "")
       | gsub("\n## (?<h>[^\n]*)\n+"; "\n#### \(.h)\n\n")
       | ltrimstr("\n") | rtrimstr("\n"))
    + (if (.notes // "") != "" then "\n\n#### How it was decided\n\n\(.notes | rtrimstr("\n"))" else "" end)
    + "\n";

  sort_by(.created_at, .id) as $all
  | "# Decisions\n\n"
  + "Generated by `script/decisions` from the decision beads. To change it,\n"
  + "change the bead and rerun the script. How decisions are made and recorded:\n"
  + "zg-pvk.\n\n"
  + "| Bead | Decision | Areas |\n|---|---|---|\n"
  + ([$all[] | "| \(.id) | \(.title) | \(areas) |"] | join("\n")) + "\n"
  + ([("Accepted", "To decide", "Superseded or withdrawn") as $s
      | [$all[] | select(state == $s)]
      | select(length > 0)
      | "\n## \($s)\n\n" + ([.[] | entry] | join("\n"))]
     | join(""))
  | rtrimstr("\n")
' <<<"$decisions" >"$out"

echo "wrote $out"
